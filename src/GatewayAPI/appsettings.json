{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Debug"
    }
  },
  "AllowedHosts": "*",
  "PollySettings": {
    "RetryCount": 3,
    "RetryDelayMs": 500,
    "CircuitBreakerHandledEventsPerSec": 100,
    "CircuitBreakerDurationOfBreakSec": 30,
    "CircuitBreakerSamplingDurationSec": 30,
    "CircuitBreakerMinimumThroughput": 8,
    "RequestTimeoutSec": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5176"
    ]
  }
}
